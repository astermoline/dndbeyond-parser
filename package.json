{
  "name": "@astermoe/dndbeyond-parser",
  "version": "1.0.0",
  "description": "Universal parser for D&D Beyond characters, monsters, and items into normalized models and Markdown.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "dndbeyond",
    "dnd5e",
    "parser",
    "markdown",
    "foundry-vtt",
    "character-sheet"
  ],
  "author": {
    "name": "Aster Moline",
    "email": "aster@moline.dev",
    "url": "https://aster.quest"
  },
  "homepage": "https://aster.quest",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astermoline/dndbeyond-parser.git"
  },
  "bugs": {
    "url": "https://github.com/astermoline/dndbeyond-parser/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^1.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
